# Copy to backend/.env and frontend/.env — never commit real secrets.
# Backend
PORT=4001
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4001
DATABASE_URL=postgresql://sajilo:sajilo_dev@127.0.0.1:5432/sajilo
AUTH_SECRET=change-me-to-at-least-32-random-chars-minimum-length!!
# Comma-separated extra CORS origins (portal aliases, preview deploys)
ADDITIONAL_ORIGINS=
# Cross-site cookies (split frontend/backend domains): COOKIE_SAMESITE=none + COOKIE_DOMAIN=.example.com
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
TRUST_PROXY=1
# Online payments (Nepal) — empty = provider disabled, bookings fall back to cash
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=

# Web push (VAPID) — empty = push disabled, in-app notifications still work.
# Generate with: npx --workspace backend web-push generate-vapid-keys
# Dev keys must be rotated before any public launch.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@sajilodamak.com

# Frontend
VITE_API_URL=http://localhost:4001
VITE_APEX_DOMAIN=localhost
